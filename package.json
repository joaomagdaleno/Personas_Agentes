{
  "name": "personas_agentes",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.2.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "@protobuf-ts/plugin": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "@zvec/zvec-grep": "^0.2.1",
    "winston": "^3.19.0"
  },
  "scripts": {
    "verify-all": "bun run ensure-binaries && bun run --parallel test diagnostic",
    "test": "bun test",
    "ensure-binaries": "bun run scripts/ensure_binaries.ts",
    "diagnostic": "bun run scripts/run-diagnostic.ts",
    "benchmark": "bun run scripts/benchmark.ts",
    "forge": "bun run scripts/forge.ts",
    "ui": "bun run scripts/launch_ui.ts",
    "sovereign": "bun run src_local/cli/sovereign.ts",
    "build-standalone": "bun build --compile --minify ./src_local/cli/sovereign.ts --outfile ./personas-engine.exe",
    "build-binary": "bun build --compile --minify ./src_local/cli/sovereign.ts --outfile ./bin/personas-orchestrator.exe"
  }
}