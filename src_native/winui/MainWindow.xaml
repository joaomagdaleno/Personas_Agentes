<Window
    x:Class="PersonasAgentes.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="⚡ Personas Harness — Sovereign Agentic Workbench">

    <Grid Background="#0E0F12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- LEFT SIDEBAR (DEEPSEEK HARNESS STYLE)                                    -->
        <!-- ========================================================================= -->
        <Border Grid.Column="0" Background="#131418" BorderBrush="#1F2128" BorderThickness="0,0,1,0" Padding="12,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header: Brand Logo & Collapse Toggle -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="#2563EB" CornerRadius="5" Padding="5,3">
                            <TextBlock Text="⚡" FontSize="12" Foreground="#FFFFFF"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="personas" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="harness" FontSize="14" FontWeight="Light" Foreground="#3B82F6"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Click="OnToggleSidebarClicked"
                            Background="Transparent" BorderThickness="0" Padding="4,2" CornerRadius="4">
                        <TextBlock Text="🔲" FontSize="12" Foreground="#64748B"/>
                    </Button>
                </Grid>

                <!-- 2. Wide Rounded "+ New Session" Button -->
                <Button Grid.Row="1" Click="OnNewSessionClicked" HorizontalAlignment="Stretch" Height="36"
                        Background="#21232B" Foreground="#F1F5F9" BorderBrush="#2D303A" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="➕" FontSize="12"/>
                        <TextBlock Text="New Session" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <!-- 3. Workspaces Section Header -->
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock Text="Workspaces" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <Button Click="OnNewSessionClicked" Background="Transparent" BorderThickness="0" Padding="2">
                            <TextBlock Text="🔍" FontSize="10" Foreground="#64748B"/>
                        </Button>
                        <Button Click="OnOpenSettingsClicked" Background="Transparent" BorderThickness="0" Padding="2">
                            <TextBlock Text="⚙️" FontSize="10" Foreground="#64748B"/>
                        </Button>
                        <Button Click="OnNewSessionClicked" Background="Transparent" BorderThickness="0" Padding="2">
                            <TextBlock Text="➕" FontSize="10" Foreground="#64748B"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 4. Workspaces & Sessions List -->
                <ListView x:Name="SessionsListView" Grid.Row="3" SelectionChanged="OnSessionSelectionChanged" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" CornerRadius="6" Padding="8,6" Background="#1B1C22">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="📁" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="#F1F5F9" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 5. Fixed Bottom Settings Button -->
                <Button Grid.Row="4" Click="OnOpenSettingsClicked" HorizontalAlignment="Left"
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Padding="6,8" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚙️" FontSize="13"/>
                        <TextBlock Text="Settings" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- CENTRAL WORKSPACE AREA (EXACT DEEPSEEK HARNESS LAYOUT)                    -->
        <!-- ========================================================================= -->
        <Grid Grid.Column="1" Background="#0E0F12">

            <!-- 1. MAIN CHAT / AGENT WORKBENCH VIEW -->
            <Grid x:Name="MainWorkbenchView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- A. CENTER HERO PLACEHOLDER (VISIBLE BEFORE PROMPT) -->
                <ScrollViewer x:Name="TrajectoryScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <Grid Padding="24">
                        <!-- Hero Section (Shown when Trajectory is Empty) -->
                        <StackPanel x:Name="HeroStackPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Margin="0,80,0,40" MaxWidth="700">
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="32" VerticalAlignment="Center"/>
                                <TextBlock Text="Into the Sovereign Workbench" FontSize="26" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="Preview" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                </Border>
                            </StackPanel>

                            <!-- Pill Dropdown Controls -->
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Border Background="#181920" BorderBrush="#282A36" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="📁" FontSize="11"/>
                                        <TextBlock Text="Personas_Agentes" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1"/>
                                        <TextBlock Text="▾" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#181920" BorderBrush="#282A36" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🔀" FontSize="11"/>
                                        <ComboBox x:Name="ModeComboBox" SelectionChanged="OnModeSelectionChanged"
                                                  Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" FontSize="11" Padding="0">
                                            <ComboBoxItem Content="Standard mode" IsSelected="True"/>
                                            <ComboBoxItem Content="Code mode"/>
                                            <ComboBoxItem Content="Minimal mode"/>
                                            <ComboBoxItem Content="Creator mode"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dynamic Trajectory Stream Cards Ledger -->
                        <StackPanel x:Name="TrajectoryStackPanel" Spacing="12" MaxWidth="800" HorizontalAlignment="Center"/>
                    </Grid>
                </ScrollViewer>

                <!-- B. FLOATING CENTERED COMMAND DOCK (DSH INPUT CARD) -->
                <Grid Grid.Row="1" Padding="20,10,20,24" HorizontalAlignment="Center" Width="720">
                    <Border Background="#1A1B22" BorderBrush="#2B2D3A" BorderThickness="1" CornerRadius="16" Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Prompt Input TextBox -->
                            <TextBox x:Name="PromptTextBox" Grid.Row="0"
                                     PlaceholderText="Ask anything or request agent code task..."
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" MinHeight="48"
                                     KeyDown="OnPromptKeyDown"
                                     Background="Transparent" Foreground="#F1F5F9" BorderThickness="0"
                                     FontSize="13" Padding="0,0,0,8"/>

                            <!-- Inner Toolbar Row -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Toolbar Actions -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Background="#232530" Foreground="#94A3B8" BorderThickness="0" CornerRadius="12" Width="28" Height="28" Padding="0">
                                        <TextBlock Text="➕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                    <Border Background="#232530" BorderBrush="#323542" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="🛡️" FontSize="11"/>
                                            <TextBlock Text="Workspace Write" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1"/>
                                            <TextBlock Text="▾" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right Model Selector & Send Button -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ComboBox x:Name="ModelSelectorComboBox" SelectionChanged="OnModelSelectionChanged"
                                              Background="#232530" Foreground="#CBD5E1" BorderBrush="#323542" CornerRadius="12" Height="30" FontSize="11">
                                        <ComboBoxItem Content="⚡ qwen2.5-coder-1.5b (Fast)" Tag="qwen2.5-coder-1.5b" IsSelected="True"/>
                                        <ComboBoxItem Content="🛠️ qwen2.5-coder-7b (Coder)" Tag="qwen2.5-coder-7b"/>
                                        <ComboBoxItem Content="🧠 qwen3-8b-thinking (Architect)" Tag="qwen3-8b-thinking"/>
                                    </ComboBox>

                                    <Button x:Name="DispatchButton" Click="OnDispatchClicked"
                                            Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" CornerRadius="14" Width="32" Height="32" Padding="0">
                                        <TextBlock Text="↑" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 2. SETTINGS OVERLAY PAGE -->
            <Grid x:Name="SettingsOverlayView" Visibility="Collapsed" Background="#0E0F12" Padding="32">
                <Grid MaxWidth="850" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel Spacing="4">
                            <TextBlock Text="⚙️ Settings &amp; Governance" FontSize="20" FontWeight="Bold" Foreground="#F1F5F9"/>
                            <TextBlock Text="Manage personas plugins, model downloads, and system resource limits." FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                        <Button Click="OnCloseSettingsClicked" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#1F2128" Foreground="#F1F5F9" BorderThickness="0" CornerRadius="6" Padding="12,6">
                            <TextBlock Text="✕ Close" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20">
                            <!-- Section 1: Super Personas Hub -->
                            <Border Background="#131418" BorderBrush="#1F2128" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="🔌 8 Super Personas Plugins" FontSize="14" FontWeight="Bold" Foreground="#F1F5F9"/>
                                    <ListView x:Name="PersonasListView" SelectionChanged="OnPersonaSelectionChanged" Background="Transparent">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,2" CornerRadius="6" Padding="10,6" Background="#1B1C22">
                                                    <Grid>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="12"/>
                                                            <TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="10"/>
                                                        </StackPanel>
                                                        <Border HorizontalAlignment="Right" Background="#064E3B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="Active" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Model Management -->
                            <Border Background="#131418" BorderBrush="#1F2128" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="📥 Local SLM Weight Downloader" FontSize="14" FontWeight="Bold" Foreground="#F1F5F9"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="DownloadModelButton" Click="OnDownloadModelClicked"
                                                Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" CornerRadius="6" Padding="14,8">
                                            <TextBlock Text="Download Selected Model Weights" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                        <ProgressBar x:Name="DownloadProgressBar" Width="180" Height="8" Minimum="0" Maximum="100" Value="0"
                                                     Visibility="Collapsed" VerticalAlignment="Center" Foreground="#3B82F6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section 3: System Telemetry & Server -->
                            <Border Background="#131418" BorderBrush="#1F2128" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="🌐 Server &amp; System Health" FontSize="14" FontWeight="Bold" Foreground="#F1F5F9"/>
                                    <TextBlock Text="Server Host: http://127.0.0.1:3080" FontSize="11" Foreground="#CBD5E1"/>
                                    <TextBlock x:Name="SlmStateTextBlock" Text="SLM State: Purged (0MB)" FontSize="11" Foreground="#60A5FA"/>
                                    <Button Click="OnRefreshTasksClicked" Background="#1F2128" Foreground="#60A5FA" BorderBrush="#2D303A" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                        <TextBlock Text="Refresh Background Task Queue" FontSize="11" FontWeight="Medium"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>
