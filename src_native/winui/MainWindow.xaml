<Window
    x:Class="PersonasAgentes.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="🏛️ Personas &amp; Agentes — WinUI 3 Native DeepSeek Harness Desktop">

    <Grid Background="#11111B">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: Super Personas Selector -->
        <Border Grid.Column="0" Background="#181825" BorderBrush="#313244" BorderThickness="0,0,1,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
                    <TextBlock Text="🏛️ Super Personas" FontSize="18" FontWeight="Bold" Foreground="#CDD6F4"/>
                    <TextBlock Text="Selecione a Persona Ativa:" FontSize="12" Foreground="#A6ADC8"/>
                </StackPanel>

                <!-- Persona List -->
                <ListView x:Name="PersonasListView" Grid.Row="1" SelectionChanged="OnPersonaSelectionChanged" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8,6" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#CDD6F4" FontSize="13"/>
                                <TextBlock Text="{Binding Category}" Foreground="#A6ADC8" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Status Footer -->
                <StackPanel Grid.Row="2" Spacing="4" Margin="0,16,0,0">
                    <Border Background="#313244" CornerRadius="6" Padding="8,6">
                        <TextBlock x:Name="StatusTextBlock" Text="🟢 DSH Native Host (http://127.0.0.1:3080)" FontSize="11" Foreground="#A6ADC8"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Chat & Reasoning Content Area (100% Native XAML) -->
        <Grid Grid.Column="1" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ActivePersonaTitle" Text="🧠 Strategic Cognitive Architect" FontSize="16" FontWeight="Bold" Foreground="#CDD6F4"/>
                        <TextBlock Text="Mux Stream Event Protocol &amp; Idris 2 Formal Safety Verifier" FontSize="12" Foreground="#A6ADC8"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Limpar Conversa" Click="OnClearChatClicked" Background="#313244" Foreground="#CDD6F4"/>
                </Grid>
            </Border>

            <!-- Native Chat Message History (ListView with Expander Reasoning) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel x:Name="MessagesStackPanel" Spacing="12"/>
            </ScrollViewer>

            <!-- Input Area -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PromptTextBox" Grid.Column="0" PlaceholderText="Digite seu prompt ou dúvida sobre a arquitetura do projeto..."
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" KeyDown="OnPromptKeyDown"
                         Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244" CornerRadius="8,0,0,8" Padding="12,10"/>
                <Button Grid.Column="1" Content="Enviar 🚀" Click="OnSendClicked"
                        Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Height="42" CornerRadius="0,8,8,0" Padding="16,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
