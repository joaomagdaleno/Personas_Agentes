<Window
    x:Class="PersonasAgentes.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="⚡ DeepSeek Harness (dsh) — Agentic Workbench &amp; Cordis Plugin Engine">

    <Grid Background="#0D0E12">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- TOP HEADER BAR: DeepSeek Harness Telemetry Bar & Controls                -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#13151C" BorderBrush="#1F2330" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- DeepSeek Harness Brand Title & Plugin Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Padding="6,4">
                        <TextBlock Text="⚡" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="deepseek" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="harness" FontSize="16" FontWeight="Light" Foreground="#3B82F6" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                        <TextBlock Text="dsh v2.0" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    </Border>
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="5,2">
                        <TextBlock Text="CORDIS ENGINE" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                    </Border>
                </StackPanel>

                <!-- DSH Mode & Model Selector Dock -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Modo:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ModeComboBox" SelectionChanged="OnModeSelectionChanged"
                              Background="#181B24" Foreground="#F1F5F9" BorderBrush="#2A2F40" CornerRadius="6" Height="30" FontSize="11">
                        <ComboBoxItem Content="Standard" IsSelected="True"/>
                        <ComboBoxItem Content="Code"/>
                        <ComboBoxItem Content="Minimal"/>
                        <ComboBoxItem Content="Creator"/>
                    </ComboBox>

                    <TextBlock Text="Modelo:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <ComboBox x:Name="ModelSelectorComboBox" SelectionChanged="OnModelSelectionChanged"
                              Background="#181B24" Foreground="#F1F5F9" BorderBrush="#2A2F40" CornerRadius="6" Height="30" FontSize="11">
                        <ComboBoxItem Content="⚡ Qwen 2.5 Coder 1.5B (Fast / Lite)" Tag="qwen2.5-coder-1.5b" IsSelected="True"/>
                        <ComboBoxItem Content="🛠️ Qwen 2.5 Coder 7B (Coder)" Tag="qwen2.5-coder-7b"/>
                        <ComboBoxItem Content="🧠 Qwen3-8B Thinking (Architect)" Tag="qwen3-8b-thinking"/>
                    </ComboBox>

                    <Button x:Name="DownloadModelButton" Click="OnDownloadModelClicked"
                            Background="#1E293B" Foreground="#60A5FA" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="6" Height="30" FontSize="10" Padding="10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📥 Baixar Modelo" FontSize="10" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <ProgressBar x:Name="DownloadProgressBar" Width="90" Height="6" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed" VerticalAlignment="Center" Foreground="#3B82F6"/>
                </StackPanel>

                <!-- Realtime Performance Telemetry Chips -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="#181B24" BorderBrush="#262B3A" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⚡" FontSize="10"/>
                            <TextBlock x:Name="TelemetryTokensTextBlock" Text="Tokens/s: 0.0" FontSize="10" Foreground="#34D399" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#181B24" BorderBrush="#262B3A" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="💾" FontSize="10"/>
                            <TextBlock x:Name="TelemetryCacheTextBlock" Text="Cache: 0.0%" FontSize="10" Foreground="#60A5FA" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#181B24" BorderBrush="#262B3A" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⏱️" FontSize="10"/>
                            <TextBlock x:Name="TelemetryLatencyTextBlock" Text="Latência: 0ms" FontSize="10" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#181B24" BorderBrush="#262B3A" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="10"/>
                            <TextBlock x:Name="TelemetryTurnsTextBlock" Text="Turnos: 0" FontSize="10" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Engine & Backend Host Status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border x:Name="SlmStateBorder" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <TextBlock x:Name="SlmStateTextBlock" Text="❄️ SLM: Purged (0MB)" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                    </Border>
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="🟢 Host: 3080" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- MAIN WORKSPACE: 3-Column Agentic Workbench Layout                         -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================================== -->
            <!-- COLUMN 0: Left Sidebar (Sessions & Plugin Architecture)               -->
            <!-- ===================================================================== -->
            <Border Grid.Column="0" Background="#111319" BorderBrush="#1F2330" BorderThickness="0,0,1,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>

                    <!-- Sessions Section Header & New Session Button -->
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="SESSÕES &amp; FORKS" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Button Click="OnNewSessionClicked" HorizontalAlignment="Right" Padding="8,4" Background="#1E293B" BorderBrush="#334155" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="➕" FontSize="10"/>
                                    <TextBlock Text="Nova" FontSize="11" Foreground="#F1F5F9" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Sessions List -->
                    <ListView x:Name="SessionsListView" Grid.Row="1" SelectionChanged="OnSessionSelectionChanged" Background="Transparent" Margin="0,0,0,8">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" CornerRadius="6" Padding="8,6" Background="#181B24" BorderBrush="#262B3A" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="📁" FontSize="11"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Info}" Foreground="#64748B" FontSize="9"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Plugins / Personas Section Header -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,6">
                        <TextBlock Text="🔌 PLUGINS DE PERSONA (DSH)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    </StackPanel>

                    <!-- Personas / Plugins List -->
                    <ListView x:Name="PersonasListView" Grid.Row="3" SelectionChanged="OnPersonaSelectionChanged" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" CornerRadius="6" Padding="8,5" Background="#181B24" BorderBrush="#262B3A" BorderThickness="1">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="#F1F5F9" FontSize="11"/>
                                        <TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="9"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ===================================================================== -->
            <!-- COLUMN 1: Central Trajectory View (Agent Execution Flight Recorder)   -->
            <!-- ===================================================================== -->
            <Grid Grid.Column="1" Background="#0D0E12" Padding="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Timing & Execution Overview Bar -->
                <Border Grid.Row="0" Background="#13151C" BorderBrush="#1F2330" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="MÉTRICAS DE DESEMPENHO:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="TtftTextBlock" Text="TTFT: 0ms" FontSize="10" Foreground="#60A5FA" FontWeight="Medium"/>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="DecodingTextBlock" Text="Decoding: 0ms" FontSize="10" Foreground="#34D399" FontWeight="Medium"/>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="TotalDurationTextBlock" Text="Duração: 0ms" FontSize="10" Foreground="#FBBF24" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="Limpar Trajetória" Click="OnClearTrajectoryClicked" Background="#1E293B" Foreground="#F1F5F9" BorderBrush="#334155" CornerRadius="6" Height="26" FontSize="10" Padding="10,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Trajectory Execution Stream Ledger -->
                <ScrollViewer x:Name="TrajectoryScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <StackPanel x:Name="TrajectoryStackPanel" Spacing="10"/>
                </ScrollViewer>

                <!-- DSH Command Dock & Input Prompt -->
                <Border Grid.Row="2" Background="#13151C" BorderBrush="#1F2330" BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Input Prompt Box -->
                        <TextBox x:Name="PromptTextBox" Grid.Row="0"
                                 PlaceholderText="Digite uma instrução, tarefa de código ou consulta para o harness executar..."
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" MinHeight="44"
                                 KeyDown="OnPromptKeyDown"
                                 Background="Transparent" Foreground="#F1F5F9" BorderThickness="0"
                                 FontSize="13" Padding="0,2,0,6"/>

                        <!-- Dock Modifiers & Dispatch Action Bar -->
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Agent Plugin Modifiers -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ToggleButton x:Name="DeepThinkToggle" Click="OnDeepThinkToggleClicked"
                                              Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                              CornerRadius="14" Padding="10,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🧠" FontSize="11"/>
                                        <TextBlock Text="DeepThink Pro" FontSize="10" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton x:Name="RAGAnchorToggle" IsChecked="True"
                                              Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                              CornerRadius="14" Padding="10,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🔍" FontSize="11"/>
                                        <TextBlock Text="ZvecGrep RAG" FontSize="10" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton x:Name="IdrisVerifierToggle" IsChecked="True"
                                              Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                              CornerRadius="14" Padding="10,3">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🔬" FontSize="11"/>
                                        <TextBlock Text="Idris 2 Safety" FontSize="10" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <!-- Dispatch & Cancel Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="CancelButton" Click="OnCancelClicked"
                                        Background="#451A22" Foreground="#F87171" BorderBrush="#991B1B" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" Height="32">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🛑 Cancelar" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DispatchButton" Click="OnDispatchClicked"
                                        Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0"
                                        CornerRadius="6" Padding="14,6" Height="32">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Executar Turno" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="🚀" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- COLUMN 2: Right Inspector & Tool Plugin Drawer                        -->
            <!-- ===================================================================== -->
            <Border Grid.Column="2" Background="#111319" BorderBrush="#1F2330" BorderThickness="1,0,0,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Inspector Header -->
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                        <TextBlock Text="INSPECTOR DE ETAPA (STEP)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="InspectorTitleTextBlock" Text="Selecione um nó da Trajetória" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9"/>
                    </StackPanel>

                    <!-- Step Execution Details & Payload -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <Border Background="#181B24" BorderBrush="#262B3A" BorderThickness="1" CornerRadius="6" Padding="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="METADADOS DE EXECUÇÃO" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock x:Name="InspectorMetaTextBlock" Text="Status: Pronto&#x0a;Duração: N/A&#x0a;Tokens Estimados: N/A" FontSize="11" Foreground="#CBD5E1"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#181B24" BorderBrush="#262B3A" BorderThickness="1" CornerRadius="6" Padding="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="PAYLOAD / RESUMO" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock x:Name="InspectorPayloadTextBlock" Text="Nenhuma etapa selecionada." TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Registered Tools Header -->
                    <TextBlock Grid.Row="2" Text="FERRAMENTAS REGISTRADAS (TOOLS)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,10,0,6"/>

                    <!-- Tools List -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="4">
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="🩺 system.run_diagnostic (360° Health)" FontSize="10" Foreground="#34D399" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="🛡️ audit.staged (Git Risk &amp; Security)" FontSize="10" Foreground="#60A5FA" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="📚 registry.list_stacks (9 Polyglot Stacks)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="🧪 healing.run_auto_heal (Atomic Healer)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="⚡ native.governance_status (16GB RAM/CPU)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="📝 todo.write (Imperative Snapshot)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="🌐 web.search / fetch (Markdown RAG)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="🧠 skill.load (Modular Skill Registry)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="🗄️ session_query_sql (bun:sqlite DB)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="🐙 github.webhook (Autonomous CI/CD)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="💻 terminal.pty (Continuous Shell)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="🔍 lsp.definition (Semantic Symbols)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="⚡ zvec_grep.search (SIMD Fast RAG)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="🔬 idris2_verifier.verify (Formal Proofs)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="📁 fs.read / write / edit (Sandboxed)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="🐚 shell.exec (PowerShell Native)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                            <Border Background="#181B24" CornerRadius="4" Padding="6,4">
                                <TextBlock Text="🤝 subagent.spawn (Parallel Sessions)" FontSize="10" Foreground="#F1F5F9"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Export Trajectory & Task Queue Actions -->
                    <StackPanel Grid.Row="4" Spacing="6" Margin="0,10,0,0">
                        <Button HorizontalAlignment="Stretch" Click="OnRefreshTasksClicked"
                                Background="#181B24" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <TextBlock Text="🔄" FontSize="11"/>
                                <TextBlock Text="Fila de Tarefas de Segundo Plano" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Click="OnExportTrajectoryClicked"
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <TextBlock Text="📜" FontSize="11"/>
                                <TextBlock Text="Exportar Trajetória (SHA-256)" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
